{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepsake Atelier",
  "version": "0.1.0",
  "identifier": "click.keepsakeatelier.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keepsake Atelier",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Blu-ray ripping & authoring",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "resources/ffmpeg": "ffmpeg",
      "resources/ffprobe": "ffprobe",
      "resources/ffmpeg-LICENSES.txt": "ffmpeg-LICENSES.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ghostyshell/keepsake-atelier/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4OEUyRDMzRTM1QjM3NUMKUldSY04xdmpNeTJPS0xMSUY4QWJFbDRGL1ZxMFBCQk1HNzZqZDNYUnZ6SDFsVzJpQ2NJSW5oYnAK"
    }
  }
}
